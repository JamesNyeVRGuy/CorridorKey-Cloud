# Stage 1: Build Svelte SPA
FROM node:20-slim AS frontend
WORKDIR /build

# Vite bakes `import.meta.env.CKWEB_FILE_BASE` during `npm run build`, and
# ARGs do not cross stage boundaries, so Stage 1 needs its own declaration.
# Empty default falls back to same-origin on the client.
ARG CKWEB_FILE_BASE=""
ENV CKWEB_FILE_BASE=${CKWEB_FILE_BASE}

COPY web/frontend/package.json web/frontend/package-lock.json* ./
RUN npm ci
COPY web/frontend/ .
RUN npm run build

# Stage 2: Python runtime
FROM ghcr.io/astral-sh/uv:0.7-python3.11-bookworm-slim

WORKDIR /app

RUN useradd --create-home --uid 1000 appuser

# Runtime dependencies for OpenCV/video I/O.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libgl1 \
    libglib2.0-0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies (including web extra).
COPY --chown=appuser:appuser pyproject.toml uv.lock ./
ARG CK_INSTALL_CUDA=false
RUN --mount=type=cache,target=/root/.cache/uv \
    sh -c 'if [ "$CK_INSTALL_CUDA" = "true" ]; then uv sync --frozen --no-dev --extra web --extra cuda --no-install-project; else uv sync --frozen --no-dev --extra web --no-install-project; fi'

# Copy project source.
COPY --chown=appuser:appuser . .

# Install the project itself.
RUN --mount=type=cache,target=/root/.cache/uv \
    sh -c 'if [ "$CK_INSTALL_CUDA" = "true" ]; then uv sync --frozen --no-dev --extra web --extra cuda; else uv sync --frozen --no-dev --extra web; fi'

# Copy built frontend from stage 1.
COPY --from=frontend /build/build /app/web/frontend/build

# Ensure Projects dir exists and is owned by appuser
RUN mkdir -p /app/Projects && chown appuser:appuser /app/Projects

USER appuser

ARG BUILD_COMMIT=dev
ARG BUILD_NUMBER=0

# Runtime value for the backend (CORS + Caddy vhost). Must match Stage 1.
ARG CKWEB_FILE_BASE=""
ENV OPENCV_IO_ENABLE_OPENEXR=1
ENV CKWEB_FILE_BASE=${CKWEB_FILE_BASE}
ENV CK_CLIPS_DIR=/app/Projects
ENV CK_BUILD_COMMIT=${BUILD_COMMIT}
ENV CK_BUILD_NUMBER=${BUILD_NUMBER}

EXPOSE 3000

CMD ["/app/.venv/bin/uvicorn", "web.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "3000", "--timeout-keep-alive", "300"]
