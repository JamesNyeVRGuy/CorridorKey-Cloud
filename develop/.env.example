# Local ports
FRONTEND_PORT=3000
CK_PORT=3001
POSTGRES_PORT=54322
GOTRUE_PORT=54324
POSTGREST_PORT=54321
STUDIO_PORT=54323
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://corridorkey-web:3000
CKWEB_FILE_BASE=
WATCHPACK_POLLING=true

# CorridorKey
CK_AUTH_ENABLED=true
CK_AUTH_TOKEN=
CK_ENVIRONMENT=development
CK_LOG_FORMAT=json
CK_METRICS_ENABLED=true
CK_DOCS_PUBLIC=true
CK_SERVE_LEGACY_FRONTEND=false
CK_MAX_UPLOAD_MB=10240
CK_CHUNK_SIZE_MB=500
CK_STORAGE_BACKEND=local
CK_PROJECTS_DIR=./Projects
CK_WEIGHTS_DIR=./weights
CK_REDIS_URL=redis://redis:6379/0
CK_DATABASE_URL=postgresql://supabase_admin:development-password@db:5432/corridorkey
CK_MIGRATION_URL=postgresql://supabase_admin:development-password@db:5432/corridorkey
CK_GOTRUE_INTERNAL_URL=http://auth:9999
CK_GOTRUE_URL=http://localhost:54324
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:54321
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:3000/
CK_SCHEDULE_TIMEZONE=UTC
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
CK_INSTALL_CUDA=false

# Database and Supabase
POSTGRES_DB=corridorkey
POSTGRES_PASSWORD=development-password-change-me
JWT_SECRET=development-jwt-secret-change-me
# Must match JWT_SECRET; the Python API reads this name.
CK_JWT_SECRET=development-jwt-secret-change-me
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
CK_SUPABASE_SERVICE_KEY=
CK_ADMIN_EMAIL=
SUPABASE_PUBLIC_URL=http://localhost:54321
PG_META_CRYPTO_KEY=development-meta-key-change-me
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=true

# Optional storage
CK_S3_BUCKET=
CK_S3_PREFIX=
CK_S3_ENDPOINT_URL=
CK_S3_REGION=us-east-1
CK_S3_ACCESS_KEY_ID=
CK_S3_SECRET_ACCESS_KEY=

# Optional SMTP. Leave blank for the default no-email development flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@corridorkey.local
SMTP_SENDER_NAME=CorridorKey

# Local admin and observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=development-admin-password-change-me
PROMTAIL_LOG_PATH=/var/lib/docker/containers

# Optional integrations and profiles
SENTRY_DSN=
DISABLE_TELEMETRY=true
